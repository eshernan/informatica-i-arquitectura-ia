FROM docker.io/library/python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY requirements-container.txt .
RUN pip install --no-cache-dir -r requirements-container.txt
COPY app ./labs/librereserva/app
RUN touch ./labs/__init__.py ./labs/librereserva/__init__.py

USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "labs.librereserva.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
